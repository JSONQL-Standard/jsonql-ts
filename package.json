{
  "name": "@jsonql-standard/jsonql-ts",
  "version": "1.1.0",
  "description": "Official Node.js SDK for JSONQL with support for Express, Fastify, and NestJS",
  "license": "MIT",
  "author": "JSONQL Standard",
  "homepage": "https://jsonql.org/sdk/typescript/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JSONQL-Standard/jsonql-ts.git"
  },
  "bugs": {
    "url": "https://github.com/JSONQL-Standard/jsonql-ts/issues"
  },
  "keywords": [
    "jsonql",
    "query",
    "sql",
    "mongodb",
    "orm",
    "express",
    "fastify",
    "nestjs",
    "transpiler"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:cli",
    "build:lib": "tsc",
    "build:cli": "tsc -p tsconfig.cli.json",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "bench": "tsx benchmark/parser.ts && tsx benchmark/transpiler.ts"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^6.0.3",
    "@types/yargs": "^17.0.35",
    "benchmark": "^2.1.4",
    "express": "^4.22.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "jest": "^29.7.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite": "^5.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "yargs": "^17.7.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "mysql2": "^3.24.2"
  },
  "optionalDependencies": {
    "mongodb": "^6.21.0",
    "pg": "^8.16.3",
    "sqlite3": "^6.0.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "express": "^4.0.0",
    "fastify": "^5.12.1",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "overrides": {
    "js-yaml": "^3.15.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "node-tar": "^7.5.21",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^1.1.16",
    "body-parser": "^1.20.6"
  }
}
